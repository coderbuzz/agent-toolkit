{
  "schema_version": 1,
  "name": "agent-toolkit",
  "version": "2.0.0",
  "description": "Vendor-neutral work lanes, agents, skills, and platform exports for coding agents.",
  "canonical": {
    "skills": ".agents/skills",
    "instructions": "instructions",
    "standards": "standards",
    "templates": "templates"
  },
  "platforms": [
    "codex",
    "opencode",
    "github-copilot",
    "claude-code",
    "omp",
    "gemini"
  ],
  "skills": {
    "lifecycle": [
      "start",
      "discover",
      "define",
      "design",
      "plan",
      "implement",
      "verify",
      "review",
      "fix",
      "release",
      "document"
    ],
    "cross_cutting": [
      "grill",
      "context",
      "guardrails",
      "memory",
      "glossary",
      "decide",
      "test",
      "threat",
      "audit-deps",
      "orchestrate"
    ],
    "optional": [
      "design-ui",
      "incident",
      "observability",
      "migrate"
    ]
  },
  "bundles": {
    "core": [
      "lifecycle",
      "cross_cutting"
    ],
    "full": [
      "lifecycle",
      "cross_cutting",
      "optional"
    ],
    "quality": [
      "grill",
      "guardrails",
      "test",
      "threat",
      "audit-deps",
      "verify",
      "review"
    ]
  },
  "install_policy": {
    "default_scope": "global",
    "supported_scopes": [
      "repository",
      "global"
    ],
    "default_bundle": "core",
    "overwrite": "never",
    "preview_required": true,
    "generated_output": "dist"
  }
}
